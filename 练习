#include <iostream>;
using namespace std;
float main()
{
    int n;
    cin >> n;
    int min_cost = 1000000;
    for (int i = 0; i < 3; i++)
    {
        int count, price;
        cin >> count >> price;
        int preck = n / count;
        if (n % count != 0)
        {
            preck++;
        }
        int num = preck * price;
        if (num < min_cost)
        {
            min_cost = num;
        }
    }
    cout << min_cost << endl;
    return 0;
}
