#include <iostream>
using namespace std;

void myswap01(int a, int b)//值传递  形参不会修饰实参
{
	int temp = a;
	a = b;
	b = temp;

	cout << "a=" << a << endl;
	cout << "b=" << b << endl;
}


void myswap02(int* a, int* b)//地址传递（指针）形参会修饰实参
{
	int temp = *a;
	*a = *b;
	*b = temp;
}


void myswap03(int& a, int& b)//引用  形参会修饰实参
{
	int temp = a;
	a = b;
	b = temp;
}


int main()
{
	int a = 10;
	int b = 20;
	myswap03(a, b);
	cout << "a=" << a << endl;
	cout << "b=" << b << endl;
}
