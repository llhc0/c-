#include <iostream>
using namespace std;

struct Student
{
	string sName;
	int score;
};


struct Teacher
{
	string tName;
	struct Student sArry[5];
	int Size;
};


void aoo(struct Teacher tArray[], int len)
{
	string nameSeed = "ABCDE";
	for (int i = 0; i < len; i++)
	{
		tArray[i].tName = "Teacher_";
		tArray[i].tName += nameSeed[i];

		for (int j = 0; j < 5; j++)
		{
			tArray[i].sArry[j].sName = "Student_";
			tArray[i].sArry[j].sName += nameSeed[j];

			int random = rand() % 61 + 40;
			tArray[i].sArry[j].score = random;
		}


	}
}

void printinfo(struct Teacher tArray[],int len)
{
	for (int i = 0; i < len; i++)
	{
		cout << "老师姓名" << tArray[i].tName << endl;

		for (int j = 0; j < 5; j++)
			cout << "\t学生姓名" << tArray[i].sArry[j].sName 
			<< "考试分数" << tArray[i].sArry[j].score << endl;
	}
};



int main()
{
	srand((unsigned int)time(NULL));

	struct Teacher tArray[3];
	int len = sizeof(tArray) / sizeof(tArray[0]);
	aoo(tArray, len);

	printinfo(tArray, len);
	system("pause");
	return 0;



}
